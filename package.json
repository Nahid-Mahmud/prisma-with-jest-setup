{
  "name": "prisma-with-jest-setup",
  "version": "1.0.0",
  "description": "A backend project using Prisma ORM with Jest testing framework",
  "main": "index.js",
  "scripts": {
    "test": "NODE_ENV=test jest --runInBand",
    "dev": "tsx watch src/server.ts",
    "build": "npx eslint ./src && tsc",
    "start": "node ./dist/server.js",
    "postinstall": "prisma generate",
    "lint": "npx eslint ./src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-mock-extended": "^4.0.1",
    "lint-staged": "^17.3.0",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "http-status-codes": "^2.3.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": "prettier --write"
  }
}
